<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD" />
    <uses-permission android:name="android.permission.MANAGE_VOICE_KEYPHRASES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".HermiAutomotiveApp"
        android:allowBackup="true"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hermi" >

        <activity
            android:name=".ui.HermiAssistantActivity"
            android:theme="@style/Theme.Hermi.Assistant"
            android:launchMode="singleInstance"
            android:exported="false"
            android:showForAllUsers="true" />

        <service
            android:name=".service.HermiCarAppService"
            android:exported="true">
<!--            <intent-filter>-->
<!--                <action android:name="androidx.car.app.CarAppService" />-->
<!--                <category android:name="androidx.car.app.category.IOT" />-->
<!--            </intent-filter>-->
        </service>

        <service
            android:name=".service.HermiVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/hermi_voice_interaction" />
        </service>

        <service
            android:name=".service.HermiVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
        </service>

        <service
            android:name=".service.HermiRecognitionService"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/hermi_recognition_config" />
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

    </application>
</manifest>